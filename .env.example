APP_NAME="Access Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accesshub.your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=accesshub_database
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Access Hub
# ---------------------------------------------------------------------------

# Break-glass admin — seeded once by `php artisan db:seed --class=AdminSeeder`.
# In production BOTH must be set (the seeder refuses to run otherwise).
# Document these credentials offline; the admin can change the password in-app.
BREAKGLASS_ADMIN_EMAIL=
BREAKGLASS_ADMIN_PASSWORD=

# External org user directory (bulk list endpoint).
# APP_KEY MUST be identical to the directory system's — the user ids are
# encrypted with its key. Never run `php artisan key:generate` after deploy.
USER_API_ENDPOINT=https://bfcgroup.ph/api/v1/users
USER_API_KEY=

# Cloudflare Turnstile on the login form. Strongly recommended for a public
# admin login. Set to true and fill both keys.
TURNSTILE_VERIFY=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Serve over HTTPS only — set true in production.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
